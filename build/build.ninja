# Test rules

build test: phony meson-internal__test

build meson-internal__test: CUSTOM_COMMAND all meson-test-prereq PHONY
 COMMAND = /home/wsl/.local/bin/meson test --no-rebuild --print-errorlogs
 DESC = Running$ all$ tests
 pool = console

build benchmark: phony meson-internal__benchmark

build meson-internal__benchmark: CUSTOM_COMMAND all meson-benchmark-prereq PHONY
 COMMAND = /home/wsl/.local/bin/meson test --benchmark --logbase benchmarklog --num-processes=1 --no-rebuild
 DESC = Running$ benchmark$ suite
 pool = console

# Install rules

build install: phony meson-internal__install

build meson-internal__install: CUSTOM_COMMAND PHONY | all
 DESC = Installing$ files
 COMMAND = /home/wsl/.local/bin/meson install --no-rebuild
 pool = console

build dist: phony meson-internal__dist

build meson-internal__dist: CUSTOM_COMMAND PHONY
 DESC = Creating$ source$ packages
 COMMAND = /home/wsl/.local/bin/meson dist
 pool = console

# Suffix

build scan-build: phony meson-internal__scan-build

build meson-internal__scan-build: CUSTOM_COMMAND PHONY
 COMMAND = /home/wsl/.local/bin/meson --internal scanbuild /home/wsl/YSPACE/vcom-copy/vcom-copy /home/wsl/YSPACE/vcom-copy/vcom-copy/build subprojects /home/wsl/.local/bin/meson setup -D:commands_type=plugins -D:enable_can=true
 pool = console

build uninstall: phony meson-internal__uninstall

build meson-internal__uninstall: CUSTOM_COMMAND PHONY
 COMMAND = /home/wsl/.local/bin/meson --internal uninstall
 pool = console

build all: phony vcom

build meson-test-prereq: phony 

build meson-benchmark-prereq: phony 

build clean: phony meson-internal__clean

build clean-ctlist: phony meson-internal__clean-ctlist

build meson-internal__clean-ctlist: CUSTOM_COMMAND PHONY
 COMMAND = /home/wsl/.local/bin/meson --internal cleantrees /home/wsl/YSPACE/vcom-copy/vcom-copy/build/meson-private/cleantrees.dat
 description = Cleaning$ custom$ target$ directories

build meson-internal__clean: CUSTOM_COMMAND PHONY | clean-ctlist
 COMMAND = /home/wsl/.local/bin/ninja -t clean
 description = Cleaning

build build.ninja: REGENERATE_BUILD ../meson.build /home/wsl/YSPACE/vcom-copy/vcom-copy/meson_options.txt /usr/bin/git ../include/meson.build ../include/conf_vcom.h.in meson-private/coredata.dat
 pool = console

build reconfigure: REGENERATE_BUILD PHONY
 pool = console

build ../meson.build /home/wsl/YSPACE/vcom-copy/vcom-copy/meson_options.txt /usr/bin/git ../include/meson.build ../include/conf_vcom.h.in meson-private/coredata.dat: phony 

default all

